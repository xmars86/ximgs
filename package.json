{
  "name": "ximgs",
  "version": "0.3.6",
  "description": "单机跨境图床：单机版本地目录定时同步上传（S3 兼容单桶）",
  "main": "./out/main/index.js",
  "author": "xImgs",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('请使用 pnpm 安装依赖：pnpm install'); process.exit(1)}\"",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "pnpm install",
    "make-installer": "pnpm run build:win",
    "smoke:b2": "node scripts/smoke-b2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "electron-log": "^5.4.3",
    "pinia": "^3.0.3",
    "sql.js": "^1.13.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
